{
  "name": "tiny-rex",
  "private": true,
  "version": "1.0.0",
  "description": "Tiny Rex: Crystal Valley — a cheerful procedural 2D side-scrolling platformer for the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
